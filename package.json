{
  "name": "kompagnon-app",
  "version": "0.0.0",
  "description": "The mobile application of Kompagnon service",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "version": "node scripts/update-version.js && git add ."
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@env$": "<rootDir>/__mocks__/@env.js"
    }
  },
  "type": "module",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.3.0",
    "@react-navigation/native-stack": "^7.17.1",
    "dotenv": "^17.4.2",
    "expo": "~54.0.0",
    "expo-env": "^1.1.1",
    "expo-font": "~14.0.12",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-dotenv": "^3.4.11",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "babel-preset-expo": "~54.0.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0"
  }
}
