# This file is the minimal configuration of environment

# ==============================
# Api url
# The base url of the API server
# Type: string
KOMPAGNON_API_URL=http://localhost:3000

# OpenRouteService key, used to draw the walking route on the journey map.
# Optional: without it the map falls back to a dashed straight line between the
# two ends, which is what it drew before. Free key at
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
